# build outputs (produced by `npm run build`; published to npm via package.json "files")
dist/
native/
node_modules/
*.tsbuildinfo
# esbuild-prebuilt reanimated chunks (regenerated by `bun run prebuild:reanimated`)
.reanimated-prebuilt/
# reload-conformance mkdtemp workdirs (removed in its finally; left behind by a hard kill)
.rngpui-reload-*/
